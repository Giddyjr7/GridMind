# ========================================================
# GridMind Frontend Environment Variables (Example Template)
# ========================================================
# Copy this file to .env.local for local development.

# Operational data mode: "mock" (default for Phase 0-2) | "api"
NEXT_PUBLIC_DATA_MODE=mock

# Base URL for the FastAPI backend (used only when NEXT_PUBLIC_DATA_MODE=api)
# Backend contract endpoints will be finalized before enabling API mode.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Application metadata
NEXT_PUBLIC_APP_NAME=GridMind
NEXT_PUBLIC_APP_VERSION=0.1.0-alpha

# Telemetry polling / refresh cadence in milliseconds (15s default)
NEXT_PUBLIC_REFRESH_INTERVAL_MS=15000

# ========================================================
# Authentication & Identity Provider (Phase 2 & 3 Backend Integration)
# ========================================================
# Google OAuth 2.0 / OIDC Client ID (Public Web Client ID from Google Cloud Console)
# Leave empty to keep Google auth in demo-notice mode.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Supabase Auth / FastAPI OAuth2 Provider URL (when using Supabase/FastAPI backend)
NEXT_PUBLIC_AUTH_PROVIDER=mock
